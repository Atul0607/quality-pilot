FROM mcr.microsoft.com/playwright/python:v1.55.0-noble@sha256:640d578aae63cfb632461d1b0aecb01414e4e020864ac3dd45a868dc0eff3078

WORKDIR /tests
COPY demo/requirements-e2e.lock .
RUN python -m pip install --no-cache-dir --upgrade pip==25.2 \
    && python -m pip install --no-cache-dir --require-hashes -r requirements-e2e.lock
COPY demo/tests ./tests
COPY demo/pytest.ini .
CMD ["pytest", "-q"]
